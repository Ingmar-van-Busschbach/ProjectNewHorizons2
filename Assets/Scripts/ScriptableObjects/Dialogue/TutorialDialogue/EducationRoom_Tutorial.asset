  dialogue:
  - speakerName: Plague Doctor Rat
    dialogue: 
    dialogue: "Oh! The school, that\u2019ll be very important to you in a moment. "
    printDuration: 0.05
    dialogueVoice: {fileID: 0}
  - speakerName: Plague Doctor Rat
    dialogue: 'You can see whether a rat is educated in its Smarts statistics, and
      we need some proper scientists to develop my Opus Plague further. '
    printDuration: 0.05
    dialogueVoice: {fileID: 0}
  - speakerName: Plague Doctor Rat
    dialogue: 'After some time, the rats you assign here will graduate and receive
      official permission to work in the lab alongside me. '
    printDuration: 0.05
    dialogueVoice: {fileID: 0}
  - speakerName: Plague Doctor Rat
    dialogue: "That is, if a little educational discipline doesn\u2019t deter them,
      of course\u2026"
    printDuration: 0.05
    dialogueVoice: {fileID: 0}
  endScene: 0
