  dialogue:
  - speakerName: Plague Doctor Rat
    dialogue: "Aha! Our colony. Welcome, welcome. It\u2026 erm\u2026 used to bustle
      with life, but those damned humans-"
    printDuration: 0.05
    dialogueVoice: {fileID: 0}
  - speakerName: Plague Doctor Rat
    dialogue: "Right, right\u2026 We seem to have just about enough rats left to
      keep our bar and trash room running. "
    printDuration: 0.05
    dialogueVoice: {fileID: 0}
  - speakerName: Plague Doctor Rat
    dialogue: "The bar provides our food, that is, as long as someone is working
      there, of course. Be sure to keep it running, as all your rats require food
      every day! Why don\u2019t you drag a rat to it?"
    printDuration: 0.05
    dialogueVoice: {fileID: 0}
  endScene: 0
