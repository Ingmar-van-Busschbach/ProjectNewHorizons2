  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f2759be2ffdb47645b3cf8b2e32470f6, type: 3}
  m_Name: FoodRoom_Tutorial
  m_EditorClassIdentifier: 
  dialogue:
  - speakerName: Plague Doctor Rat
    dialogue: 'The bar provides our food, that is, as long as someone is working
      there, of course. Be sure to keep it running!! '
    printDuration: 0.02
    dialogueVoice: {fileID: 0}
  - speakerName: Plague Doctor Rat
    dialogue: 'Every day, each rat requires one piece of food. You can see the day
      go by on the timer on the bottom left of your screen. '
    printDuration: 0.02
    dialogueVoice: {fileID: 0}
  - speakerName: Plague Doctor Rat
    dialogue: "Also, the more rats you drag to a room, the more it produces! With
      the resources, you\u2019ll be able to rebuild and unlock our other rooms. You\u2019ll
      see me around when you do. Good luck! "
    printDuration: 0.02
    dialogueVoice: {fileID: 0}
  - speakerName: Plague Doctor Rat
    dialogue: '>>>Drag a rat to the bar<<< '
    printDuration: 0.02
    dialogueVoice: {fileID: 0}
  endScene: 0
